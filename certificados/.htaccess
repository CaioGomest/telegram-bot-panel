# Esta pasta guarda certificados de gateway (.pem/.p12/.pfx) que contêm CHAVE PRIVADA.
# O PHP lê esses arquivos direto do disco (gateways.php); ninguém precisa baixá-los pela URL.
# Antes só scripts PHP eram bloqueados, então cert_<usuario>_<gateway>.pem (nome previsível)
# podia ser baixado por qualquer pessoa. Agora NENHUM arquivo daqui é servido pelo navegador.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
