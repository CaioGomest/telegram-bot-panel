# Credenciais desta instalacao. NUNCA versionar: o config.php do servidor tem o usuario
# e senha reais do banco, a CHAVE_CRIPTOGRAFIA_GATEWAYS (que descriptografa os segredos
# dos gateways) e a CHAVE_SECRETA_CRON. Versionado, qualquer git pull no servidor
# sobrescreve as credenciais de producao com as de quem commitou por ultimo.
config.php

logs/*
!logs/.gitkeep
!logs/.htaccess

uploads/*
!uploads/.gitkeep
!uploads/.htaccess

certificados/*
!certificados/.gitkeep
!certificados/.htaccess

telegram.zip
test_write.txt

storage/*
!storage/.gitkeep
!storage/.htaccess

.claude/

# Nunca versionar -- repositório é público no GitHub.
anotacoes/credenciais-ssh-hostinger.md
