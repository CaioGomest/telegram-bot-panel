# =====================================================================================================================
# config.exemplo.env — as DECISÕES DO DONO para o reset. Copie para config.env (na VPS, em /root/resetar/config.env) e preencha.
#   cp config.exemplo.env config.env && nano config.env && chmod 600 config.env
# config.env NÃO vai para o git (está no .gitignore). Aqui não há senha: a senha do admin é digitada na hora (06_senha_admin.sh).
# Nada tem valor "escondido": se um campo obrigatório estiver vazio ou inválido, os scripts param antes de apagar qualquer coisa.
# =====================================================================================================================

# Domínio do painel em produção (o 08_verificar.sh testa HTTPS e confere a url_base). Sem https:// e sem barra.
DOMINIO_ESPERADO=coyotebot.com.br

# E-mails dos administradores que FICAM (separados por vírgula). Todo o resto de `usuarios` é apagado, inclusive outros admins.
# Confira com `bash 00_conferir.sh` quem são os admins hoje. Ex.: MANTER_ADMINS=dono@seudominio.com.br
MANTER_ADMINS=

# Campanhas de ranking e prêmios:  manter | apagar
# (00_conferir.sh lista as campanhas. O cache do ranking é sempre zerado; a cron recalcula.)
RANKING=manter

# Cards da Comunidade (Admin → Comunidade):  manter | apagar | ids:1,2   (ids: apaga só esses cards)
# Na rodada de testes havia um card "123" apontando para o endereço antigo srv2059665.hstgr.cloud — apague-o com ids:N.
COMUNIDADE=manter

# Gateway OmegaPayments liberada para os vendedores (gateways.ativo=1):  ativar | manter
GATEWAY_OMEGA=ativar

# Split da plataforma (a comissão da plataforma em cada venda).  SPLIT_APLICAR=nao deixa o split como está hoje.
#   SPLIT_TIPO=fixo        → SPLIT_VALOR em reais POR COMPRA (ex.: 1.40 = R$ 1,40 em cada Pix pago, qualquer que seja o preço)
#   SPLIT_TIPO=percentual  → SPLIT_VALOR em % SOBRE O VALOR de cada venda (ex.: 5 = 5%)
#   SPLIT_ID_RECEBEDOR     → o "producerId" da conta que recebe na Omega (NÃO é chave Pix)
# Na rodada de 15/10: a VPS tinha fixo 0.25 e a homologação fixo 1.40 (cada uma com um recebedor diferente) — o dono decide qual vale.
SPLIT_APLICAR=nao
SPLIT_TIPO=fixo
SPLIT_VALOR=
SPLIT_ID_RECEBEDOR=

# Backup completo do banco antes de apagar (pode ocupar alguns GB comprimidos; o backup só de config e admins é sempre feito):  sim | nao
BACKUP_COMPLETO=sim

# Zerar as sessões do PHP (todo mundo é deslogado, inclusive você):  sim | nao
LIMPAR_SESSOES=sim

# Trocar a senha de um admin por uma forte durante o reset (interativo — o resetar-tudo.sh pede no terminal):  sim | nao
TROCAR_SENHA_ADMIN=sim
# E-mail do admin que troca a senha (se vazio, o 06 pergunta):
ADMIN_SENHA_EMAIL=
